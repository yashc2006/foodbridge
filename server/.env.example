PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
# Frontend URL allowed by CORS (use * during development)
CLIENT_ORIGIN=*
# Radius (km) within which receivers get matched/notified
MATCH_RADIUS_KM=15
# Optional: Google Gemini API key for AI food analysis (works without it using built-in rules)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
